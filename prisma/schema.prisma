// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}


enum UserROle {
    ADMIN
    USER
}
enum UserStatus {
    ACTIVE
    INACTIVE
}
enum DocsType {
    TEXT
    video
}
enum CategoryStatus {
    ACTIVE
    INACTIVE
}
enum DocStatus {
    ACTIVE
    INACTIVE
    DRAFT
}
enum CategoryLevel {
    LEVEL_1
    LEVEL_2
    LEVEL_3 
}
enum LanguageStatus {
    ACTIVE
    INACTIVE
}
enum FooterMenuStatus {
    ACTIVE
    INACTIVE
}
enum StatusType {
    ACTIVE
    INACTIVE
}

model users {
    id                  Int                @id @default(autoincrement())
    name                String
    phone               String?
    email               String             @unique
    password            String
    role                UserROle           @default(USER)
    status              UserStatus         @default(INACTIVE)
    createdAt           DateTime           @default(now())
    updatedAt           DateTime?
}

model categories {
    id                  Int                @id @default(autoincrement())
    name                String
    slug                String             @unique
    icon                String?
    level               CategoryLevel      @default(LEVEL_1)
    serial              Int?
    parentCategory      Int?              
    docs                docs[]
    categoryLanguage    categoryLanguage[]
    status              CategoryStatus     @default(ACTIVE)
    createdAt           DateTime           @default(now())
    updatedAt           DateTime?
    category            categories?        @relation("subCategories", fields: [parentCategory], references: [id])
    subCategory         categories[]       @relation("subCategories")
}

model categoryLanguage {
    id                  Int                @id @default(autoincrement())
    lang                String             
    name                String
    description         String?            @db.MediumText()
    categoryId          Int
    category            categories         @relation(fields: [categoryId], references: [id])  

}

model docs {
    id                  Int                @id @default(autoincrement())
    title               String            
    slug                String             @unique
    categoryId          Int 
    status              DocStatus          @default(ACTIVE)
    isPin               Boolean            @default(false)
    createdAt           DateTime           @default(now())
    updatedAt           DateTime?
    category            categories         @relation(fields: [categoryId], references: [id])
    docsLanguage        docsLanguage[]
    helpDocReviews      helpDocReviews[]     
}

model docsLanguage {
    id                  Int                @id @default(autoincrement())
    lang                String
    title               String
    shortDescription    String?            @db.MediumText 
    subtitle            String? 
    content             String             @db.Text
    section             Int
    docsId              Int
    docs                docs               @relation(fields: [docsId], references: [id])          
}

model language {
    id                  Int                @id @default(autoincrement())
    name                String
    flug                String?            
    code                String?             @unique
    status              LanguageStatus      @default(ACTIVE)
    createdAt           DateTime            @default(now())
    updatedAt           DateTime?
}

model footerMenu {
    id                  Int                @id @default(autoincrement())
    name                String
    newTab              Boolean            @default(false)
    url                 String?
    position            Int?               
    status              FooterMenuStatus    @default(ACTIVE)
    createdAt           DateTime            @default(now())
    updatedAt           DateTime?
    footerMenuLanguage  footerMenuLanguage[]
}

model footerMenuLanguage {
    id                  Int                @id @default(autoincrement())
    lang                String             
    name                String
    footerMenuId        Int
    footerMenu          footerMenu         @relation(fields: [footerMenuId], references: [id])  
}

model socialMedia {
    id                  Int                @id @default(autoincrement())
    name                String
    url                 String?
    logo                String?            
}
model popularSearch {
     id                  Int                @id @default(autoincrement())
     lang                String
     title               String
     count               BigInt             @default(1)
}

model settings {
    id                  Int                @id @default(autoincrement())
    fieldType           String?  
    fieldValue          String?            @db.Text          
}

model supports {
    id                  Int                @id @default(autoincrement())
    title               String
    url                 String?
    status              StatusType         @default(ACTIVE)
    createdAt           DateTime           @default(now())
    updatedAt           DateTime?
    supportLanguage     supportLanguage[]
}
model supportLanguage {
    id                  Int                @id @default(autoincrement())
    lang                String             
    title               String
    description         String?
    buttonText          String?
    supportId           Int
    support             supports         @relation(fields: [supportId], references: [id]) 
}

model helpDocReviews {
     id                  Int             @id @default(autoincrement())
     review              String?
     docId               Int
     doc                 docs            @relation(fields: [docId], references: [id])
}

model tickets {
    id                  Int              @id @default(autoincrement())
    name                String
    email               String
    subject             String?
    description         String?          @db.MediumText
    attachFile          String?                
    createdAt           DateTime         @default(now())              
}
    